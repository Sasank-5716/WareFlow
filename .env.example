# Local development placeholders only. Do not commit real credentials.
ASPNETCORE_ENVIRONMENT=Development
WAREFLOW_API_URL=http://localhost:5000
WAREFLOW_WEB_URL=http://localhost:4200
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=wareflow
POSTGRES_USER=wareflow
POSTGRES_PASSWORD=change-me-locally
REDIS_HOST=localhost
REDIS_PORT=6379
MAILPIT_HOST=localhost
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Compose service hostnames, used when the backend runs inside Compose.
COMPOSE_POSTGRES_HOST=postgres
COMPOSE_REDIS_HOST=redis
COMPOSE_MAILPIT_HOST=mailpit
